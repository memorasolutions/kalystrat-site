# ============================================================================
# .env.production.kalystrat — Template prêt à activer pour kalystrat.ca
# ============================================================================
# Copier ce fichier vers /home/{cpanel_user}/kalystrat/.env (sur cPanel)
# puis remplir les valeurs marquées "TO_FILL" et générer la APP_KEY :
#   php artisan key:generate
# ============================================================================

# === Application ===
APP_NAME="Kalystrat"
APP_ENV=production
APP_KEY=                                           # TO_FILL: php artisan key:generate
APP_DEBUG=false
APP_URL=https://kalystrat.ca
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_CA
APP_TIMEZONE=America/Montreal
APP_MAINTENANCE_DRIVER=file

# === Logs ===
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                                  # info en debug, warning en prod stable

# === Database (cPanel MySQL) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                                       # TO_FILL: nom DB cPanel (préfixe utilisateur)
DB_USERNAME=                                       # TO_FILL: user DB cPanel
DB_PASSWORD=                                       # TO_FILL: password DB cPanel

# === Sessions / Cache (file driver — pas de Redis sur cPanel mutualisé) ===
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kalystrat.ca
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database                          # ou sync si pas de cron worker

# === Sécurité production ===
BCRYPT_ROUNDS=12
FORCE_HTTPS=true
CSP_ENABLED=true

# === Mail SMTP ===
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=                                         # TO_FILL: smtp.kalystrat.ca ou smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                                     # TO_FILL: ex. info@kalystrat.ca
MAIL_PASSWORD=                                     # TO_FILL: password mail
MAIL_FROM_ADDRESS=info@kalystrat.ca
MAIL_FROM_NAME="Kalystrat"

# === Identité légale (Loi 25 Québec, RGPD, CCPA) ===
COMPANY_NAME="Gestion Kalystrat Inc."
COMPANY_ADDRESS="Québec (QC), Canada"
COMPANY_EMAIL=info@kalystrat.ca
COMPANY_PHONE="+14184760987"
DPO_EMAIL=info@kalystrat.ca

# === Layout Slot pour module Privacy (intégration thème Frontend) ===
PRIVACY_LAYOUT="frontend::layouts.legal-shell"

# === Telescope / Debugbar (DESACTIVER en prod) ===
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# === Modules désactivés ===
# AI / Booking / Translation = false dans modules_statuses.json (pas via .env)

# === Response cache (perf) ===
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=3600
RESPONSE_CACHE_DRIVER=file

# === Backups (Spatie laravel-backup) ===
BACKUP_NAME="kalystrat"
BACKUP_DISK=local

# === Sentry (error tracking — à activer après création projet) ===
SENTRY_LARAVEL_DSN=                                # TO_FILL: DSN Sentry Kalystrat
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# === Pulse (Laravel monitoring) ===
PULSE_ENABLED=true
PULSE_PATH=pulse                                   # /pulse derrière middleware super_admin

# === Admin seeder (UNIQUEMENT pour la première installation) ===
SUPER_ADMIN_EMAIL=stephane@memora.ca
ADMIN_NAME="Stéphane Lapointe"
ADMIN_EMAIL=stephane@memora.ca
ADMIN_PASSWORD=                                    # TO_FILL: password fort 16+ chars
                                                   # APRÈS seed, vider cette ligne (mot de passe stocké hashé en DB)

# === Frontend / Cookie consent ===
FRONTEND_URL=https://kalystrat.ca

# === Analytics (à activer post-déploiement GA4) ===
GA_MEASUREMENT_ID=                                 # TO_FILL: G-XXXXXXXXXX (post-création GA4 property)

# === Désactivés explicitement (pas utilisés sur Kalystrat) ===
# AWS S3 — non utilisé (storage local sur cPanel)
# Reverb (WebSocket) — non utilisé
# Stripe — non utilisé (Kalystrat = vitrine, pas SaaS)
# Twilio / Vonage — SMS non utilisé
# OAuth (Google/GitHub/Microsoft/etc.) — auth simple email/password
