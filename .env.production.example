APP_NAME="Mon Application"
SUPER_ADMIN_EMAIL=admin@votre-domaine.com
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_CA
APP_TIMEZONE=America/Montreal

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123_prod
DB_USERNAME=u123_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.votre-domaine.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.votre-fournisseur.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@votre-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (WebSocket)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=votre-domaine.com
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Horizon
HORIZON_PREFIX=laravel_horizon_

# Telescope (DESACTIVER en production)
TELESCOPE_ENABLED=false

# Backups
BACKUP_NAME="${APP_NAME}"
BACKUP_DISK=local

# Permissions
PERMISSION_CACHE_EXPIRATION_TIME=1440

# Admin
ADMIN_PATH=admin
BACKOFFICE_THEME=backend

# Security
FORCE_HTTPS=true
CSP_ENABLED=true

# Sentry (error tracking)
SENTRY_LARAVEL_DSN=

# Pulse (monitoring)
PULSE_ENABLED=true
PULSE_PATH=pulse

# Scramble (API docs)
SCRAMBLE_PATH=docs/api

# Sanctum
SANCTUM_STATEFUL_DOMAINS=votre-domaine.com
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=core_

# Response cache
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=3600
RESPONSE_CACHE_DRIVER=redis

# Stripe / SaaS
STRIPE_KEY=pk_live_
STRIPE_SECRET=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
CASHIER_CURRENCY=cad
SAAS_CURRENCY=cad
SAAS_TRIAL_DAYS=14

# PWA
PWA_ENABLED=true
PWA_SHORT_NAME="${APP_NAME}"
PWA_DESCRIPTION="Application web progressive"
PWA_THEME_COLOR="#6366f1"
PWA_BACKGROUND_COLOR="#0f172a"

# Scout
SCOUT_DRIVER=database
SCOUT_QUEUE=true

# Tenancy
TENANCY_IDENTIFICATION=domain
TENANCY_HEADER=X-Tenant-ID

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.com

# Error Monitoring
ERROR_MONITORING_ENABLED=true
ERROR_MONITORING_DRIVER=native
ERROR_MONITORING_EMAILS=admin@votre-domaine.com
ERROR_MONITORING_CHANNELS=
ERROR_MONITORING_DIGEST=true
ERROR_MONITORING_SLACK_WEBHOOK=
ERROR_MONITORING_DISCORD_WEBHOOK=

# Booking
BOOKING_SMS_ENABLED=false
BOOKING_STRIPE_ENABLED=false
BOOKING_STRIPE_CURRENCY=cad

# Booking SMS
BOOKING_SMS_PROVIDER=twilio
BOOKING_SMS_FROM=
BOOKING_SMS_VERIFY_SIGNATURE=true
BOOKING_STRIPE_WEBHOOK_SECRET=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://votre-domaine.com/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://votre-domaine.com/auth/github/callback

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://votre-domaine.com/auth/microsoft/callback
MICROSOFT_TENANT_ID=

# OAuth — Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://votre-domaine.com/auth/facebook/callback

# OAuth — LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://votre-domaine.com/auth/linkedin/callback

# OAuth — X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://votre-domaine.com/auth/x/callback

# OAuth — Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=https://votre-domaine.com/auth/apple/callback

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SMS — Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# SMS — Vonage
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SIGNATURE_SECRET=

# Analytics
GA_MEASUREMENT_ID=
FB_PIXEL_ID=

# Stripe
STRIPE_WEBHOOK_TOLERANCE=300

# Frontend
FRONTEND_URL=https://votre-domaine.com

# Health
HEALTH_DISK=local

# Admin Seeder
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=
